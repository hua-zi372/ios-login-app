name: LoginWebApp

options:
  bundleIdPrefix: com.example
  deploymentTarget:
    iOS: "15.0"
  createIntermediateGroups: true

settings:
  base:
    SWIFT_VERSION: "5.0"

targets:
  LoginWebApp:
    type: application
    platform: iOS
    sources:
      - path: Sources
    dependencies:
      - framework: Frameworks/libwebuiopsercore.framework
        embed: true
        link: false
      - framework: Frameworks/SDWebuiopser.framework
        embed: true
    preBuildScripts:
      - name: Fix framework executable bits
        script: |
          set -eu
          chmod +x "$SRCROOT/Frameworks/libwebuiopsercore.framework/libwebuiopsercore"
          chmod +x "$SRCROOT/Frameworks/SDWebuiopser.framework/SDWebuiopser"
    settings:
      base:
        PRODUCT_NAME: LoginWebApp
        PRODUCT_BUNDLE_IDENTIFIER: com.example.loginwebapp
        INFOPLIST_FILE: Info.plist
        GENERATE_INFOPLIST_FILE: NO
        TARGETED_DEVICE_FAMILY: "1,2"
        MARKETING_VERSION: "1.0.0"
        CURRENT_PROJECT_VERSION: "1"
        ENABLE_BITCODE: NO
        LD_RUNPATH_SEARCH_PATHS: "$(inherited) @executable_path/Frameworks"
